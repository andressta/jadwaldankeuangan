# Salin file ini jadi ".env" untuk pengujian lokal (opsional).
# Di Vercel, isi ini lewat: Project Settings > Environment Variables (bukan lewat file).

# API key dari console.anthropic.com (menu "API Keys")
ANTHROPIC_API_KEY=

# Sama persis dengan PIN_HASH di index.html (hasil SHA-256 dari PIN yang dipakai)
APP_AUTH_TOKEN=
